{
  "name": "microfluidic-crypto-engine-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Offline educational microfluidic logic and sensor simulator for Android and Windows.",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start:windows": "electron .",
    "copy:android-assets": "node scripts/copy-assets.cjs",
    "build:android": "node scripts/build-android.cjs",
    "build:windows": "electron-builder --win dir --x64",
    "build:windows-installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cue.microfluidic.simulator",
    "productName": "Microfluidic Crypto-Engine Simulator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["dir"],
      "icon": "resources/icon.ico",
      "artifactName": "Microfluidic-Crypto-Engine-${version}-${arch}.${ext}"
    }
  }
}
